<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>last-asylum-wiki-local-admin</UserSecretsId>
    <SpaRoot>$(MSBuildProjectDirectory)\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove=".publish-check\**" />
    <None Remove=".publish-check\**" />
    <Content Update="App_Data\checklist.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildReactApp"
          BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths"
          Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec Command="npm install --no-audit --no-fund" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npm run build:client" />
  </Target>
</Project>
